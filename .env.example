# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-if-required-for-migrations-or-admin-scripts

# Application URL
NEXT_PUBLIC_SITE_URL=https://staging.yourdomain.com
# or NEXT_PUBLIC_APP_URL=https://staging.yourdomain.com

# Staging Protection (enforces global noindex, nofollow, and robots disallow)
NEXT_PUBLIC_IS_STAGING=true

