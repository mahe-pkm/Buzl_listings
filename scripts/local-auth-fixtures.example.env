# Local-only authentication test fixtures. Copy values into your local shell or
# an ignored local environment file; never commit a service-role key or password.
BUZL_LOCAL_FIXTURES=true
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

LOCAL_FIXTURE_OWNER_EMAIL=owner@buzl.test
LOCAL_FIXTURE_OWNER_PASSWORD=<local-owner-password>
LOCAL_FIXTURE_MEMBER_EMAIL=member@buzl.test
LOCAL_FIXTURE_MEMBER_PASSWORD=<local-member-password>
LOCAL_FIXTURE_ADMIN_EMAIL=admin@buzl.test
LOCAL_FIXTURE_ADMIN_PASSWORD=<local-admin-password>
